# ==============================================================================
# HandoffIQ - Environment Configuration Template for Docker & AWS EC2
# Copy this file to .env before starting containers: cp .env.example .env
# NEVER commit the actual .env file with sensitive production secrets to Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Frontend & Network Configuration
# ------------------------------------------------------------------------------
# Public port mapped on the EC2 host (default: 80 for HTTP)
FRONTEND_PORT=80

# ------------------------------------------------------------------------------
# 2. Amazon RDS MySQL Database Configuration
# ------------------------------------------------------------------------------
# Replace with your actual Amazon RDS MySQL endpoint and credentials:
# Example: jdbc:mysql://handoffiq-db.cxxxxxxxx.us-east-1.rds.amazonaws.com:3306/handoffiq?createDatabaseIfNotExist=true&useSSL=true&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_URL=jdbc:mysql://<YOUR_RDS_ENDPOINT>:3306/handoffiq?createDatabaseIfNotExist=true&useSSL=true&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=admin
SPRING_DATASOURCE_PASSWORD=YourSecureRDSPassword123!

# Run Flyway schema & initial data migrations on startup (set to 'true' for RDS)
SPRING_FLYWAY_ENABLED=true

# ------------------------------------------------------------------------------
# 3. Security & JWT Configuration
# ------------------------------------------------------------------------------
# Generate a strong 64-character hex string (e.g., using: openssl rand -hex 32)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Allowed CORS origins (* for public or specify your domain: https://yourdomain.com)
CORS_ALLOWED_ORIGINS=*

# ------------------------------------------------------------------------------
# 4. AI Provider Configuration (Optional)
# ------------------------------------------------------------------------------
# Supported providers: gemini | openai | fallback
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=
AI_TIMEOUT_MS=15000

# ------------------------------------------------------------------------------
# 5. Document Storage Configuration
# ------------------------------------------------------------------------------
# Supported types: local | s3
STORAGE_TYPE=local
AWS_S3_BUCKET=handoffiq-documents
AWS_REGION=us-east-1
